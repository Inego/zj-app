<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug: phone on WiFi talks cleartext HTTP to the host LAN IP (zj-server BIND=0.0.0.0:8080).
  Release keeps the main config (loopback / emulator only).
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
