<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Post-splash game theme (cutout + felt). Splash attrs live on GdxSplashTheme. -->
    <style name="GdxTheme" parent="android:Theme.Material.Light.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/felt</item>
        <item name="android:colorBackground">@color/felt</item>
        <item name="android:navigationBarColor">@color/felt</item>
        <item name="android:statusBarColor">@color/felt</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!--
      API 31+: Theme.SplashScreen still used via AndroidX; platform attrs mirror
      felt so any pre-compat path matches.
    -->
    <style name="GdxSplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/felt</item>
        <!-- Foreground-style only (transparent pad); see values/styles.xml comment. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/felt</item>
        <item name="android:windowSplashScreenBackground">@color/felt</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/felt</item>
        <item name="postSplashScreenTheme">@style/GdxTheme</item>
    </style>
</resources>
